---
interface Props {
	data: Array<{
		title: string,
		cards: Array<{
			icon: string,
			title: string,
			description: string,
			link: string
		}>
	}>;
}

import DocsCard from '~/components/DocsCard.astro';

const { data } = Astro.props;
---
<div class="mt-8">
{
	data.map((item) =>(
		<h2>
			{item.title}
		</h2>
		<div class="grid gap-3 my-6 grid-cols-[repeat(auto-fill,minmax(280px,1fr))]">
			{
				item.cards.map((card) => (
					<DocsCard link={card.link} title={card.title} icon={card.icon} description={card.description} />
				))
			}
		</div>
	))
}
</div>
