---
/**
 * Renders the `<pre class="mermaid">` blocks that plugins/remark-mermaid.js
 * emits from ```mermaid fences.
 *
 * The mermaid bundle is large, so it is imported dynamically and only on a
 * page that actually holds a diagram. The original source is kept in
 * data-mermaid-source so the diagram can be redrawn when the reader switches
 * between light and dark.
 *
 * Blocks are hidden by script, never by stylesheet alone: without JavaScript,
 * or when mermaid throws, the reader still sees the diagram definition.
 */
---

<script>
	const SELECTOR = 'pre.mermaid';
	const PENDING = 'data-mermaid-pending';

	const isDark = () => document.documentElement.classList.contains('dark');

	let mermaid: any = null;
	let rendering = false;

	async function render() {
		const blocks = Array.from(document.querySelectorAll<HTMLElement>(SELECTOR));
		if (blocks.length === 0 || rendering) return;
		rendering = true;

		for (const block of blocks) {
			const source = block.dataset.mermaidSource;
			if (!source) continue;
			block.setAttribute(PENDING, '');
			// Restore the source so a redraw after a theme change has something
			// to parse instead of the SVG from the previous pass.
			block.textContent = source;
			block.removeAttribute('data-processed');
		}

		try {
			if (!mermaid) mermaid = (await import('mermaid')).default;
			// The numeric --surface-*, --text-color and --border-radius are defined
			// under the dark selector only, so each fallback carries the light value
			// rather than guarding against a missing token.
			const dark = isDark();

			const SURFACE = 'var(--surface-100, #fafafa)';
			const CANVAS = 'var(--surface-0, #f5f5f5)';
			const TEXT = 'var(--text-color, #0a0a0a)';
			const TEXT_MUTED = 'var(--text-color-secondary, #404040)';
			const BORDER = 'var(--surface-border, #d4d4d4)';
			const RADIUS = 'var(--border-radius, 6px)';

			const ACCENT = '#fe601f'; // orange.500
			const LAVANDER = '#8a84ec'; // violet.500
			const LINE = '#7f849c'; // slate.600
			const decisionBg = dark ? '#401602' : '#fff5ef'; // orange.950 / orange.50
			const shadow = dark ? 'rgba(0, 0, 0, 0.5)' : 'rgba(10, 10, 10, 0.1)';

			// Literals rather than var(): mermaid derives contrast colours from these.
			const azion = {
				background: 'transparent',
				mainBkg: dark ? '#171717' : '#fafafa',
				primaryColor: dark ? '#171717' : '#fafafa',
				primaryBorderColor: ACCENT,
				primaryTextColor: dark ? '#ededed' : '#0a0a0a',
				secondaryColor: dark ? '#222' : '#ececff',
				secondaryBorderColor: LAVANDER,
				tertiaryColor: dark ? '#111' : '#fff5ef',
				tertiaryBorderColor: dark ? '#282828' : '#ffcfb3',
				lineColor: LINE,
				textColor: dark ? '#b5b5b5' : '#404040',
				edgeLabelBackground: dark ? '#0a0a0a' : '#f5f5f5',
				clusterBkg: dark ? '#111' : '#f8f7fc',
				clusterBorder: dark ? '#282828' : '#e3e1f0',
				nodeBorder: ACCENT,
			};

			const azionCSS = `
				/* Setting stroke here would replace the neo gradient; re-point its stops. */
				.node linearGradient stop:first-child {
					stop-color: ${ACCENT};
				}
				.node linearGradient stop:last-child {
					stop-color: ${LAVANDER};
				}
				.node rect.label-container {
					rx: ${RADIUS};
					ry: ${RADIUS};
					fill: ${SURFACE};
					stroke-width: 1.25px;
					filter: drop-shadow(0 1px 2px ${shadow});
				}
				.node polygon.label-container {
					fill: ${decisionBg};
					stroke-width: 2.25px;
					filter: drop-shadow(0 2px 5px ${shadow});
				}
				.nodeLabel, .nodeLabel p {
					font-family: Sora, sans-serif;
					font-weight: 500;
					letter-spacing: -0.01em;
					color: ${TEXT};
				}
				.edgeLabel .labelBkg,
				.edgeLabel foreignObject div {
					background: ${CANVAS};
				}
				span.edgeLabel {
					background: ${CANVAS};
					padding: 1px 5px;
					font-family: Sora, sans-serif;
					font-size: 10px;
					font-weight: 600;
					letter-spacing: 0.12em;
					text-transform: uppercase;
					color: ${LAVANDER};
				}
				.cluster rect {
					rx: ${RADIUS};
					ry: ${RADIUS};
					stroke: ${BORDER};
				}
				.cluster .nodeLabel, .cluster span {
					color: ${TEXT_MUTED};
				}
				.flowchart-link {
					stroke-width: 1.25px;
					stroke-linecap: round;
					stroke-opacity: 0.85;
				}
				marker path.arrowMarkerPath {
					fill: ${LINE};
					stroke: ${LINE};
				}
			`;

			mermaid.initialize({
				startOnLoad: false,
				look: 'neo',
				theme: 'base',
				securityLevel: 'strict',
				fontFamily: 'Sora, sans-serif',
				flowchart: { useMaxWidth: true, curve: 'basis', padding: 18, nodeSpacing: 42, rankSpacing: 56 },
				themeVariables: { fontFamily: 'Sora, sans-serif', fontSize: '16px', ...azion },
				themeCSS: azionCSS,
			});

			await mermaid.run({ nodes: blocks });
		} catch (error) {
			console.error('[mermaid] failed to render a diagram', error);
		} finally {
			for (const block of blocks) block.removeAttribute(PENDING);
			rendering = false;
		}
	}

	// Redraw on theme change; the toggle sets the class on <html>.
	let lastDark = isDark();
	new MutationObserver(() => {
		if (isDark() === lastDark) return;
		lastDark = isDark();
		render();
	}).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

	render();
	document.addEventListener('astro:after-swap', render);
</script>

<style is:global>
	pre.mermaid {
		background: transparent;
		border: 0;
		padding: 0;
		margin: 1.5rem 0;
		text-align: center;
		overflow-x: auto;
	}

	pre.mermaid[data-mermaid-pending] {
		visibility: hidden;
	}

	pre.mermaid svg {
		display: block;
		margin-inline: auto;
		max-width: 100%;
		height: auto;
	}
</style>
