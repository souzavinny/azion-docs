---
/**
 * Non-visual helper: wires every "Copy prompt" button (a webkit LinkButton
 * with link="#" inside #agent-prompt-actions or [data-agent-prompt-actions])
 * to copy `prompt` to the clipboard, with a temporary label swap as feedback.
 * A page may carry more than one — the home has both a hero and a banner
 * button — so use the data attribute there and keep IDs unique.
 */
interface Props {
  prompt: string;
  copiedLabel?: string;
}

const { prompt, copiedLabel = 'Copied!' } = Astro.props;
---

<script is:inline define:vars={{ prompt, copiedLabel }}>
  (function () {
    var buttons = document.querySelectorAll(
      '#agent-prompt-actions a[href="#"], [data-agent-prompt-actions] a[href="#"]'
    );
    Array.prototype.forEach.call(buttons, function (btn) {
      var textNode = null;
      for (var i = 0; i < btn.childNodes.length; i++) {
        var node = btn.childNodes[i];
        if (node.nodeType === 3 && node.nodeValue.trim().length) {
          textNode = node;
          break;
        }
      }
      btn.addEventListener('click', function (event) {
        event.preventDefault();
        navigator.clipboard.writeText(prompt).then(function () {
          if (!textNode) return;
          var original = textNode.nodeValue;
          textNode.nodeValue = copiedLabel;
          setTimeout(function () {
            textNode.nodeValue = original;
          }, 2000);
        });
      });
    });
  })();
</script>
