---
/**
 * Standard docs CTA card — the single card pattern for content pages, kept
 * deliberately compact: icon inline with the lg title, sm description, no
 * action row. The description is NOT clamped: at the ~237px these cards get
 * in a 4-up grid, a 2-line clamp truncated every description on the home, so
 * cards show their full text and the grid equalises heights per row instead.
 * Place inside a grid div with the canonical class:
 *   <div class="grid gap-3 my-6 grid-cols-[repeat(auto-fill,minmax(280px,1fr))]">
 * (auto-fill keeps cards ~300-370px wide in any container: 4-up on the home,
 * 2-up inside the docs content column.)
 */
interface Props {
	link: string;
	title: string;
	icon?: string;
	description?: string;
	overline?: string;
	titleTag?: 'h2' | 'h3' | 'h4' | 'h5' | 'h6';
}
import CardBaseClickable from 'azion-webkit/cardbaseclickable';
import CardTitle from 'azion-webkit/cardtitle';
import CardDescription from 'azion-webkit/carddescription';

const { link, title, icon, description, overline, titleTag = 'h3' } = Astro.props;
---

<CardBaseClickable grid={true} hover="outlined" class="w-full" spacing="compact" link={link} title={title} disableAction={true}>
	<Fragment slot="content">
		<div class="flex items-center gap-3">
			{icon && <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded bg-[--surface-400]"><i class={`${icon} text-xl`}></i></span>}
			<div class="flex flex-col">
				{overline && <span class="text-overline" style="color:#F3652B">{overline}</span>}
				<CardTitle titleTag={titleTag} class="m-0 !text-lg">{title}</CardTitle>
			</div>
		</div>
		{description && <CardDescription class="!text-sm">{description}</CardDescription>}
	</Fragment>
</CardBaseClickable>
