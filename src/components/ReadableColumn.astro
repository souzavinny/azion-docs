---
/**
 * Readable column: caps the docs content column and centers it on wide
 * screens instead of letting the text stretch with the viewport. Rendered
 * once by PageContent, so every docs text page gets it. Renders nothing.
 */
---

<style is:global>
	/* the sitewide .px-container rule caps at 1344px with !important —
	   match it so the higher-specificity selector wins on these pages */
	article > section.px-container,
	article > aside.px-container {
		max-width: 56rem !important;
		margin-inline: auto;
	}
</style>
